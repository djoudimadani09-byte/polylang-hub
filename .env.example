# Database Configuration
DATABASE_URL=postgresql://polylang_user:polylang_password@db:5432/polylang_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=24h

# Server Configuration
PORT=3000
NODE_ENV=development

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DEST=./uploads

# Payment Gateway Configuration
EDAHABIA_API_KEY=your_edahabia_key
EDAHABIA_MERCHANT_ID=your_merchant_id
GOLDEN_CARD_API_KEY=your_golden_card_key
PAYMENT_MODE=test

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
