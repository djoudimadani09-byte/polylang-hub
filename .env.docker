# Database Configuration
DATABASE_URL=postgresql://polylang_user:polylang_password@db:5432/polylang_db

# JWT Configuration
JWT_SECRET=polylang_jwt_secret_production_key
JWT_EXPIRATION=24h

# Server Configuration
PORT=3000
NODE_ENV=production

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DEST=/app/uploads

# Payment Gateway Configuration
EDAHABIA_API_KEY=your_edahabia_key
EDAHABIA_MERCHANT_ID=your_merchant_id
GOLDEN_CARD_API_KEY=your_golden_card_key
PAYMENT_MODE=production
